{
  "expo": {
    "name": "AcalmaTEA",
    "slug": "AcalmaTEA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.errylan.AcalmaTEA"
    },
    "web": {
      "favicon": "./assets/logo-icon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-video",
      "expo-navigation-bar"

    ],
    "extra": {
      "eas": {
        "projectId": "194e26b4-e33f-436a-b015-e413ec2e6005"
      }
    }
  }
}
